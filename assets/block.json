{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "uplianda/site-traffic",
  "version": "1.5",
  "title": "Uplink Site Traffic for Cabin",
  "category": "widgets",
  "description": "Display Cabin site traffic with interactive charts",
  "example": {},
  "attributes": {
    "title": {
      "type": "string",
      "default": "Site Traffic"
    },
    "domain": {
      "type": "string",
      "default": ""
    },
    "chartType": {
      "type": "string",
      "default": ""
    },
    "dateRange": {
      "type": "string",
      "default": ""
    },
    "allowSwitching": {
      "type": "boolean",
      "default": true
    },
    "dashboardUrl": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": true,
    "color": {
      "text": true,
      "background": true,
      "gradients": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "fontFamily": true,
      "lineHeight": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "textdomain": "uplink-analytics-dashboard-for-cabin",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
